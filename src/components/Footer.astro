---
import ExternalLink from './ExternalLink.astro'
import Logo from './Logo.astro'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const currentYear = new Date().getFullYear()
---

<footer>
  <section class="py-16">
    <h2 class="sr-only">Footer</h2>
    <div class="container">
      <!-- Main Footer Content -->
      <div class="grid grid-cols-1 gap-12 md:grid-cols-3 mb-12">
        
        <!-- Logo and Brand Section -->
        <div class="flex flex-col gap-6 items-center md:items-start">
          <Logo loading="lazy" />
          <p class="text-sm text-gray-600 text-center md:text-left max-w-xs">
            Creating innovative solutions through passionate development and thoughtful design.
          </p>
        </div>

        <!-- Navigation Section -->
        <div class="flex flex-col gap-4 items-center md:items-start">
          <h3 class="text-xl font-bold">Quick Links</h3>
          <nav>
            <ul class="flex flex-col gap-3">
              <li><a href="/" class="hover:text-accent transition-colors duration-200">Home</a></li>
              <li><a href="/experience" class="hover:text-accent transition-colors duration-200">Experience</a></li>
              <li><a href="/projects" class="hover:text-accent transition-colors duration-200">Projects</a></li>
            </ul>
          </nav>
        </div>

        <!-- Motivational Quote Section -->
        <div class="flex flex-col gap-4 items-center md:items-start">
          <h3 class="text-xl font-bold">Inspiration</h3>
          <blockquote class="text-center md:text-left">
            <p class="text-accent italic leading-relaxed mb-2">
                "True confidence is a privilege earned only through absolute obsession"
            </p>
              <cite class="text-sm font-medium not-italic text-gray-600">— Neha Amin</cite>
          </blockquote>
        </div>
        
      </div>

      <!-- Divider -->
      <hr class="border-gray-300 dark:border-gray-700 mb-8">

      <!-- Copyright Section -->
      <div class="flex flex-col gap-4 md:flex-row md:justify-between md:items-center text-center md:text-left">
        <p class="text-sm text-gray-600">
          &copy; {currentYear} Portfolio by Neha Amin. All rights reserved.
        </p>
        <p class="text-sm text-gray-600">
          Made with ❤️ by Neha Amin
        </p>
      </div>
      
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
