---
interface Props { title?: string }
const { title = "Neha's Portfolio" }: Props = Astro.props
---

<section id="cine-intro" class="cine" style="visibility:hidden">
  <!-- Letterbox bars -->
  <div class="bars top"></div>
  <div class="bars bottom"></div>

  <!-- Countdown -->
  <div class="countdown">
    <span class="digit d3">3</span>
    <span class="digit d2">2</span>
    <span class="digit d1">1</span>
  </div>

  <!-- Title sweep -->
  <div class="title">
    <span class="txt">
      {title}
      <i class="sweep"></i>
    </span>
  </div>
</section>

<script is:inline>
  (function () {
    const KEY = "intro-seen-v1";
    const intro = document.getElementById("cine-intro");
    if (!intro) return;

    const seen = localStorage.getItem(KEY) === "1";
    if (seen) {
      intro.remove();
      return;
    }

    localStorage.setItem(KEY, "1");
    intro.style.visibility = "visible";

    const cleanup = () => {
      intro.style.opacity = "0";
      setTimeout(() => intro.parentNode && intro.remove(), 300);
    };

    intro.addEventListener("animationend", (e) => {
      if (e.animationName === "sweep") cleanup();
    });

    // Fallback cleanup (about 5s total countdown + sweep)
    setTimeout(cleanup, 5000);
  })();
</script>

<style lang="scss">
  :root {
    --cine-bg: #000;
    --cine-white: #f5f5f5;
  }

  .cine {
    position: fixed;
    inset: 0;
    background: radial-gradient(120% 120% at 50% 50%, #0b0b0b 0%, #000 60%);
    display: grid;
    place-items: center;
    overflow: hidden;
    z-index: 9999;
    transition: opacity .2s ease;
  }

  /* Letterbox bars */
  .bars {
    position: absolute; left: 0; right: 0; height: 16vh; background: #000;
    transform: translateY(0);
  }
  .bars.top    { top: -20vh; animation: bars-in-top .45s ease-out forwards; }
  .bars.bottom { bottom: -20vh; animation: bars-in-bottom .45s ease-out forwards; }

  @keyframes bars-in-top   { to { transform: translateY(20vh); } }
  @keyframes bars-in-bottom{ to { transform: translateY(-20vh); } }

  /* Countdown digits */
  .countdown {
    position: absolute; inset: 0; display: grid; place-items: center;
    font-family: ui-sans-serif, system-ui, Inter, Roboto, sans-serif;
    letter-spacing: -0.02em;
  }
  .digit {
    position: absolute;
    font-weight: 800;
    color: var(--cine-white);
    text-shadow: 0 0 30px rgba(255, 255, 255, .2);
    transform: scale(0.6);
    opacity: 0;
    animation: pop 1.1s cubic-bezier(.2,.7,.1,1) forwards;
  }
  .d3 { font-size: clamp(80px, 16vw, 220px); animation-delay: 0.15s; }
  .d2 { font-size: clamp(80px, 16vw, 220px); animation-delay: 1.15s; }
  .d1 { font-size: clamp(80px, 16vw, 220px); animation-delay: 2.15s; }

  @keyframes pop {
    0%   { opacity: 0; transform: scale(.6); filter: blur(4px); }
    15%  { opacity: 1; transform: scale(1); }
    45%  { opacity: .9; transform: scale(1.02); }
    80%  { opacity: 0; transform: scale(.7); }
    100% { opacity: 0; }
  }

  /* Title sweep */
  .title {
    position: absolute; bottom: 18vh; width: 100%;
    display: grid; place-items: center;
    opacity: 0; animation: title-in .55s ease-out 3.3s forwards;
  }
  .title .txt {
    position: relative;
    color: var(--cine-white);
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    font-size: clamp(18px, 3.2vw, 36px);
  }
  .title .sweep {
    position: absolute; inset: 0; display: block;
    background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,.0) 20%, rgba(255,255,255,.75) 50%, transparent 70%);
    transform: translateX(-120%);
    mix-blend-mode: screen;
    animation: sweep .65s ease-out 3.6s forwards;
  }

  @keyframes title-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes sweep {
    0%   { transform: translateX(-120%); opacity: .0; }
    30%  { opacity: .95; }
    100% { transform: translateX(120%); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bars, .digit, .title, .title .sweep { animation: none !important; }
    .cine { transition: none; }
  }
</style>